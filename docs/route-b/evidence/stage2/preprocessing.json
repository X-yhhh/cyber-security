  "input_rules": [
    "字段按 docs/特征规格-unsw-nb15-flow-v4.md（SHA-256 dbba110432c2…）计算；数值字段均不可为空，出现 NaN、±Inf 或负数时拒绝推理，不得补值。",
    "ct_* 来自本机单主机窗口（每个地址族最近 100 条已完成流，含当前流）；窗口未满时不推理，状态记 window_not_ready。",
    "首个模型只评估 IPv4 且本机为 responder 的流；IPv6 与出站流记 not_in_model_scope，不送推理。",
    "类别词表外取值在图内编码为 -1，后端记录为漂移信号，不拒绝记录；后端不得自行插补、编码或调整阈值。"
  ],
  "derived_features": [
    {
      "name": "rate",
      "formula": "(spkts + dpkts - 1) / dur；dur = 0 时为缺失",
      "inputs": [
        "spkts",
        "dpkts",
        "dur"
      ],
      "precision": "float64（原始值）",
      "non_finite": "NaN（随后插补）"
    },
    {
      "name": "sbytes_per_spkt",
      "formula": "sbytes / (spkts + 1)",
      "inputs": [
        "sbytes",
        "spkts"
      ],
      "precision": "输入先舍入为 float32 再以 float64 计算",
      "non_finite": "NaN（随后插补）"
    },
    {
      "name": "dbytes_per_dpkt",
      "formula": "dbytes / (dpkts + 1)",
      "inputs": [
        "dbytes",
        "dpkts"
      ],
      "precision": "输入先舍入为 float32 再以 float64 计算",
      "non_finite": "NaN（随后插补）"
    },
    {
      "name": "sbytes_dbytes_ratio",
      "formula": "sbytes / (dbytes + 1)",
      "inputs": [
        "sbytes",
        "dbytes"
      ],
      "precision": "输入先舍入为 float32 再以 float64 计算",
      "non_finite": "NaN（随后插补）"
    },
    {
      "name": "spkts_dpkts_ratio",
      "formula": "spkts / (dpkts + 1)",
      "inputs": [
        "spkts",
        "dpkts"
      ],
      "precision": "输入先舍入为 float32 再以 float64 计算",
      "non_finite": "NaN（随后插补）"
    },
    {
      "name": "synack_ackdat_diff",
      "formula": "synack - ackdat",
      "inputs": [
        "synack",
        "ackdat"
      ],
      "precision": "输入先舍入为 float32 再以 float64 计算",
      "non_finite": "NaN（随后插补）"
    },
    {
      "name": "bytes_rate",
      "formula": "(sbytes + dbytes) / (dur + 1e-6)",
      "inputs": [
        "sbytes",
        "dbytes",
        "dur"
      ],
      "precision": "输入先舍入为 float32 再以 float64 计算",
      "non_finite": "NaN（随后插补）"
    }
  ],
