{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cyber-security/response-policy/temporary-block-params.json",
  "description": "temporary_block 策略参数：窄范围、带 TTL 的主机防火墙阻断。只允许逐个列出的 IPv4 单播字面量，不接受 CIDR、主机名或端口范围；非单播、回环、未指定地址由服务层语义校验拒绝。",
  "type": "object",
  "required": ["maxTtlSeconds", "allowedTargets"],
  "additionalProperties": false,
  "properties": {
    "maxTtlSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "allowedTargets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}$"
      }
    }
  }
}
