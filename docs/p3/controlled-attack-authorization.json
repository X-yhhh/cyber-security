{
  "version": "p3-controlled-attack-auth-20261005-v2",
  "date": "2026-10-05",
  "authorizedBy": "用户明确授权，方案3：在 win-dev 自建受控扫描活动；路线A：各组使用不同连接时长以规避近重复归并",
  "purpose": "取得6个独立攻击活动组（Slowloris×3、Slowhttptest×3），使各组量化特征序列不同，满足P3独立开发评估的最低5组要求",
  "decisionRef": "docs/p3/source-repair-20261005.md",
  "nearDuplicateRootCause": "首轮6组受控活动使用相同连接时长，量化后特征序列完全一致，触发 whole_parent_quantized_sequence 规则归并为2个防泄漏组。本次通过各组使用不同目标时长，使 elapsedMs 落入不同的1000ms分桶，规避归并。",

  "scope": {
    "host": "win-dev",
    "interface": "\\Device\\NPF_Loopback",
    "local": "127.0.0.1",
    "peer": "127.0.0.2",
    "port": 80,
    "protocol": "IPv4/TCP",
    "maxConcurrentConnections": 4,
    "isolationBetweenGroupsSeconds": 155,
    "totalActivities": 6,
    "scenarios": [
      {"id": "controlled_slowloris_g1",     "mode": "slowloris",    "groupOrdinal": 1, "targetActivityDurationSeconds": 30,  "plannedRole": "train"},
      {"id": "controlled_slowloris_g2",     "mode": "slowloris",    "groupOrdinal": 2, "targetActivityDurationSeconds": 60,  "plannedRole": "validation_calibration"},
      {"id": "controlled_slowloris_g3",     "mode": "slowloris",    "groupOrdinal": 3, "targetActivityDurationSeconds": 90,  "plannedRole": "independent_development"},
      {"id": "controlled_slowhttptest_g1",  "mode": "slowhttptest", "groupOrdinal": 1, "targetActivityDurationSeconds": 45,  "plannedRole": "validation_selection"},
      {"id": "controlled_slowhttptest_g2",  "mode": "slowhttptest", "groupOrdinal": 2, "targetActivityDurationSeconds": 75,  "plannedRole": "independent_development"},
      {"id": "controlled_slowhttptest_g3",  "mode": "slowhttptest", "groupOrdinal": 3, "targetActivityDurationSeconds": 105, "plannedRole": "independent_development"}
    ]
  },

  "attackParameters": {
    "slowloris": {
      "description": "发送不完整HTTP头，每隔数秒追加一个头字段，维持连接不关闭",
      "initialHeaders": ["GET / HTTP/1.1", "Host: 127.0.0.1", "User-Agent: test"],
      "keepAliveIntervalSeconds": 10,
      "maxConnectionsPerGroup": 4
    },
    "slowhttptest": {
      "description": "发送带 Content-Length 的 POST，以极低速率分片发送请求体",
      "bodyTotalBytes": 8192,
      "bytesSentPerInterval": 1,
      "intervalSeconds": 5,
      "maxConnectionsPerGroup": 4
    }
  },

  "captureRequirements": {
    "format": "原生 DLT_NULL PCAP via Npcap",
    "zeroDrop": true,
    "includeFullPayload": true,
    "perGroupIsolation": true,
    "engineResetBetweenGroups": true
  },

  "constraints": [
    "仅限登记的回环接口，仅 127.0.0.1:80，仅 IPv4/TCP",
    "不改防火墙规则，不改系统配置",
    "活动结束后立即停止攻击连接、释放监听和捕获进程",
    "每组独立引擎、独立 boot/capture、独立输出目录",
    "捕获文件原生保存，不生成去 AF 头副本",
    "trainingAllowed 保持 false 直到新 corpus 冻结并通过核验",
    "不读取 P6 封存特征/标签/分数",
    "活动结束后清理所有临时进程，恢复干净状态",
    "各组 targetActivityDurationSeconds 必须与登记值一致，不得在采集中修改",
    "同场景三组的 elapsedMs 量化分桶必须互不相同（1000ms精度）"
  ],

  "outputDirectory": "artifacts/p3/controlled-attack-v2-20261005/",
  "gitCommitted": false,
  "gitPushed": false
}
