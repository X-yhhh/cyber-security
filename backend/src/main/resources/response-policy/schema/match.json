{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cyber-security/response-policy/match.json",
  "description": "响应策略匹配范围。首期只按资产环境匹配，必须与策略 environment 相同（语义校验在服务层）。PolicyGuard 只识别该键，未知键会让策略永远无法匹配，因此一律拒绝。",
  "type": "object",
  "required": ["environment"],
  "additionalProperties": false,
  "properties": {
    "environment": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$" }
  }
}
