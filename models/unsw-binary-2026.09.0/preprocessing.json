          "unit": "计数",
          "description": "最近 100 条连接中同服务同源地址的连接数",
          "nullable": false,
          "min": 0
        },
        {
          "index": 15,
          "name": "ct_state_ttl",
          "unit": "计数",
          "description": "按状态与 TTL 区间统计的编号",
          "nullable": false,
          "min": 0
        },
        {
          "index": 16,
          "name": "ct_dst_ltm",
          "unit": "计数",
          "description": "最近 100 条连接中同目的地址的连接数",
          "nullable": false,
          "min": 0
        },
        {
          "index": 17,
          "name": "ct_src_dport_ltm",
          "unit": "计数",
          "description": "最近 100 条连接中同源地址同目的端口的连接数",
          "nullable": false,
          "min": 0
        },
        {
          "index": 18,
          "name": "ct_dst_sport_ltm",
          "unit": "计数",
          "description": "最近 100 条连接中同目的地址同源端口的连接数",
          "nullable": false,
          "min": 0
        },
        {
          "index": 19,
          "name": "ct_dst_src_ltm",
          "unit": "计数",
