    { "name": "synack", "unit": "second", "source": "flow", "min": 0, "integer": false, "unitVerified": true, "specSection": "2.1#7" },
    { "name": "smean", "unit": "byte", "source": "flow", "min": 0, "integer": true, "unitVerified": true, "specSection": "2.1#8" },
    { "name": "dmean", "unit": "byte", "source": "flow", "min": 0, "integer": true, "unitVerified": true, "specSection": "2.1#9" },
    { "name": "spkts", "unit": "packet", "source": "flow", "min": 1, "integer": true, "unitVerified": true, "specSection": "2.1#10" },
