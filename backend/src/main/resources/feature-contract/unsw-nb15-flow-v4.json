  "flowClosure": { "tcpIdleSeconds": 60, "udpIdleSeconds": 30, "otherIdleSeconds": 30, "maxLifetimeSeconds": 60 },
  "packetNormalization": { "basis": "on_wire_segments", "oversizeRule": "split_by_mss" },
