[
  {
    "ruleKey": "tcp-port-scan",
    "version": "1",
    "severity": "high",
    "scope": {
      "featureContractVersion": "unsw-nb15-flow-v4"
    },
    "reason": "疑似扫描：同资产 60 秒内观察到首个 SYN、但未获得完整握手计时的入站 TCP 流达到 30 条；不计不同端口，不区分扫描与连接故障",
    "condition": {
      "all": [
        {
          "field": "features.proto",
          "op": "eq",
          "value": "tcp"
        },
        {
          "field": "metadata.viewpoint",
          "op": "eq",
          "value": "responder"
        },
        {
          "field": "metadata.handshakeSeen",
          "op": "eq",
          "value": true
        },
        {
          "field": "features.synack",
          "op": "eq",
          "value": 0
        }
      ],
      "window": {
        "seconds": 60,
        "aggregate": "count",
        "threshold": 30,
        "groupBy": "asset"
      }
    }
  },
  {
    "ruleKey": "ssh-login-failure-burst",
    "version": "1",
    "severity": "high",
    "scope": {
      "featureContractVersion": "unsw-nb15-flow-v4"
    },
    "reason": "SSH 短连接突发：同资产 60 秒内握手计时完整、持续不足 10 秒的入站 SSH 流达到 10 条；流特征不能确认登录失败",
    "condition": {
      "all": [
        {
          "field": "features.proto",
          "op": "eq",
          "value": "tcp"
        },
        {
          "field": "features.service",
          "op": "eq",
          "value": "ssh"
        },
        {
          "field": "metadata.viewpoint",
          "op": "eq",
          "value": "responder"
        },
        {
          "field": "metadata.handshakeSeen",
          "op": "eq",
          "value": true
        },
        {
          "field": "features.tcprtt",
          "op": "gt",
          "value": 0
        },
        {
          "field": "features.dur",
          "op": "lt",
          "value": 10
        }
      ],
      "window": {
        "seconds": 60,
        "aggregate": "count",
        "threshold": 10,
        "groupBy": "asset"
      }
    }
  },
  {
    "ruleKey": "web-short-request-burst",
    "version": "1",
    "severity": "medium",
    "scope": {
      "featureContractVersion": "unsw-nb15-flow-v4"
    },
    "reason": "非 SSH TCP 短连接突发：同资产 60 秒内握手计时完整、持续不足 1 秒的入站非 SSH 流达到 50 条；覆盖受控 Web 场景，但不能确认 HTTP 协议或路径探测",
    "condition": {
      "all": [
        {
          "field": "features.proto",
          "op": "eq",
          "value": "tcp"
        },
        {
          "field": "features.service",
          "op": "ne",
          "value": "ssh"
        },
        {
          "field": "metadata.viewpoint",
          "op": "eq",
          "value": "responder"
        },
        {
          "field": "metadata.handshakeSeen",
          "op": "eq",
          "value": true
        },
        {
          "field": "features.tcprtt",
          "op": "gt",
          "value": 0
        },
        {
          "field": "features.dur",
          "op": "lt",
          "value": 1
        }
      ],
      "window": {
        "seconds": 60,
        "aggregate": "count",
        "threshold": 50,
        "groupBy": "asset"
      }
    }
  },
  {
    "ruleKey": "udp-inbound-burst",
    "version": "1",
    "severity": "medium",
    "scope": {
      "featureContractVersion": "unsw-nb15-flow-v4"
    },
    "reason": "UDP 突发：同资产 30 秒事件时间窗口内入站 UDP 流的发起方包数合计达到 300；以已封流记录统计，不代表逐包实时速率",
    "condition": {
      "all": [
        {
          "field": "features.proto",
          "op": "eq",
          "value": "udp"
        },
        {
          "field": "metadata.viewpoint",
          "op": "eq",
          "value": "responder"
        }
      ],
      "window": {
        "seconds": 30,
        "aggregate": "sum",
        "field": "features.spkts",
        "threshold": 300,
        "groupBy": "asset"
      }
    }
  }
]
