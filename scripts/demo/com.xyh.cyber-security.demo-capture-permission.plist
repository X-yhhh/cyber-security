<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.xyh.cyber-security.demo-capture-permission</string>
	<key>UserName</key>
	<string>root</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/PrivilegedHelperTools/com.xyh.cyber-security.demo-capture-permission</string>
		<string>__CAPTURE_USER__</string>
		<string>__PRIVATE_ROOT__</string>
		<!-- B4 填写 ps -o command= 显示的解释器绝对路径，说明见 scripts/demo/README.md。 -->
		<string>__PYTHON_PS_PATH__</string>
		<string>__RUN_PY_ABSOLUTE_PATH__</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
</dict>
</plist>
