  "input_rules": [
    "非 nullable 数值字段出现 NaN、±Inf 或负数时拒绝推理（fail-closed），不得补 0 或补中位数。",
    "nullable 字段（ct_flw_http_mthd）以 NaN 表示缺失，由图内中位数插补并生成缺失指示列。",
    "类别字段为 UNSW-NB15 Argus 输出的原始小写字符串；词表外取值在图内编码为 -1，后端应记录为漂移信号。",
    "字段单位必须与 UNSW-NB15 一致（dur 为秒，sinpkt/dinpkt/sjit/djit 为毫秒，sload/dload 为比特/秒）；来源不能证明单位一致时拒绝推理。"
  ],
  "derived_features": [
    {
      "name": "rate",
      "formula": "(spkts + dpkts - 1) / dur；dur = 0 时为缺失",
      "inputs": [
        "spkts",
        "dpkts",
        "dur"
      ],
      "precision": "float64（原始值）",
      "non_finite": "NaN（随后插补）"
    },
    {
      "name": "sbytes_per_spkt",
      "formula": "sbytes / (spkts + 1)",
      "inputs": [
        "sbytes",
        "spkts"
      ],
      "precision": "输入先舍入为 float32 再以 float64 计算",
      "non_finite": "NaN（随后插补）"
    },
    {
      "name": "dbytes_per_dpkt",
      "formula": "dbytes / (dpkts + 1)",
      "inputs": [
        "dbytes",
        "dpkts"
      ],
      "precision": "输入先舍入为 float32 再以 float64 计算",
      "non_finite": "NaN（随后插补）"
    },
    {
      "name": "sbytes_dbytes_ratio",
      "formula": "sbytes / (dbytes + 1)",
      "inputs": [
        "sbytes",
        "dbytes"
      ],
      "precision": "输入先舍入为 float32 再以 float64 计算",
      "non_finite": "NaN（随后插补）"
    },
    {
      "name": "spkts_dpkts_ratio",
      "formula": "spkts / (dpkts + 1)",
      "inputs": [
        "spkts",
        "dpkts"
      ],
      "precision": "输入先舍入为 float32 再以 float64 计算",
      "non_finite": "NaN（随后插补）"
    },
    {
      "name": "synack_ackdat_diff",
      "formula": "synack - ackdat",
      "inputs": [
        "synack",
        "ackdat"
      ],
      "precision": "输入先舍入为 float32 再以 float64 计算",
      "non_finite": "NaN（随后插补）"
    },
    {
      "name": "bytes_rate",
      "formula": "(sbytes + dbytes) / (dur + 1e-6)",
      "inputs": [
        "sbytes",
        "dbytes",
        "dur"
      ],
      "precision": "输入先舍入为 float32 再以 float64 计算",
      "non_finite": "NaN（随后插补）"
    }
  ],
